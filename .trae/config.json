{
  "name": "ShardXL",
  "description": "Cross-platform Minecraft Java Edition Launcher with Rust backend",
  "version": "1.0.0",
  "framework": "flutter",
  "stateManagement": "riverpod",
  "themeSystem": "custom_material3_shadcn",
  "backend": {
    "language": "rust",
    "coreLibrary": "external/ShardXL-Lib",
    "androidCore": "external/ShardXL-AndroidCore",
    "ffiBindings": "lib/frb/shardxl_ffi_bindings.dart"
  },
  "ai": {
    "skill": ".skill",
    "rules": ".rules",
    "projectRules": ".trae/rules/project_rules.md",
    "context": {
      "include": [
        "lib/**/*.dart",
        "external/ShardXL-Lib/**/*.rs",
        "external/ShardXL-Lib/**/Cargo.toml",
        "pubspec.yaml",
        "*.md"
      ],
      "exclude": [
        ".dart_tool/**",
        "build/**",
        ".flutter-plugins-dependencies",
        "external/ShardXL-Lib/target/**",
        "external/ShardXL-AndroidCore/**/build/**"
      ]
    }
  },
  "codeGeneration": {
    "templates": {
      "widget": {
        "prefix": "shard",
        "description": "ShardXL Widget Template"
      },
      "provider": {
        "prefix": "shard",
        "description": "ShardXL Provider Template"
      },
      "page": {
        "prefix": "shard",
        "description": "ShardXL Page Template"
      }
    }
  },
  "theme": {
    "style": "shadcn-ui",
    "defaultPrimaryColor": "#7C4DFF",
    "defaultDarkMode": true,
    "enableGlassEffect": true,
    "cardOpacity": 0.65,
    "defaultBorderRadius": 6.0
  }
}